<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <VSTestResultsDirectory>$(MSBuildProjectDirectory)\..\TestResults\$(MSBuildProjectName)\</VSTestResultsDirectory>
    <TestResultsDirectory>$(MSBuildProjectDirectory)\..\TestResults\$(MSBuildProjectName)\</TestResultsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\App4di.Dotnet.UserManager.Core\App4di.Dotnet.UserManager.Core.csproj" />
    <ProjectReference Include="..\App4di.Dotnet.UserManager.Model\App4di.Dotnet.UserManager.Model.csproj" />
  </ItemGroup>

</Project>
