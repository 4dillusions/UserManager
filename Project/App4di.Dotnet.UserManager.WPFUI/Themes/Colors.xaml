<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Semantic palette -->
    <Color x:Key="PrimaryColor">#1E96A6</Color>
    <Color x:Key="AccentColor">#29ADC6</Color>
    <Color x:Key="BackgroundColor">#262626</Color>
    <Color x:Key="SurfaceColor">#E2E2E2</Color>
    <Color x:Key="TextColor">#000000</Color>
    <Color x:Key="MutedTextColor">#526B77</Color>
    <Color x:Key="BorderColor">#1A1A1A</Color>
    <Color x:Key="ErrorColor">#FF0000</Color>
    <Color x:Key="SuccessColor">#2E7D32</Color>

    <!-- Supporting colors that preserve the existing appearance -->
    <Color x:Key="PrimaryLightColor">#60D8F0</Color>
    <Color x:Key="ControlBorderColor">#2194A7</Color>
    <Color x:Key="InputBackgroundColor">#FFFFFF</Color>
    <Color x:Key="HeaderTextColor">#FFFFFF</Color>
    <Color x:Key="HeaderGradientStartColor">#303231</Color>
    <Color x:Key="HeaderGradientEndColor">#474747</Color>
    <Color x:Key="FooterGradientStartColor">#0B0B0B</Color>
    <Color x:Key="FooterGradientEndColor">#1A1A1A</Color>
    <Color x:Key="AlternatingRowColor">#DCDCDC</Color>
    <Color x:Key="InactiveSelectionColor">#A8DDE6</Color>
    <Color x:Key="InactiveSelectionTextColor">#16313D</Color>

</ResourceDictionary>
