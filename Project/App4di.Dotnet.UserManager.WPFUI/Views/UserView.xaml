<UserControl
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:validators="clr-namespace:App4di.Dotnet.UserManager.WPFUI.Validation"
        xmlns:converters="clr-namespace:App4di.Dotnet.UserManager.WPFUI.Converters"
        xmlns:res="clr-namespace:App4di.Dotnet.UserManager.WPFUI" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        mc:Ignorable="d" x:Class="App4di.Dotnet.UserManager.WPFUI.UserView" Width="746" Height="414" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <StackPanel>
        <Label Content="{Binding HeaderText}" Padding="10,5,5,5" FontSize="20" FontWeight="Bold" Width="746" VerticalAlignment="Center" Foreground="{StaticResource HeaderTextBrush}"
                   Background="{StaticResource HeaderBackgroundBrush}"/>
        <Label Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="7"/>
        <Image Width="100" Height="100" Margin="0, 10, 0, 0" Source="../Contents/editUser.png"/>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
                <RowDefinition Height="28" />
                <RowDefinition Height="28" />
                <RowDefinition Height="28" />
                <RowDefinition Height="28" />
                <RowDefinition Height="28" />
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="125" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label Grid.Row="1" Grid.Column="0" Content="Login Name" HorizontalAlignment="Left"/>
            <TextBox x:Name="LoginText" Grid.Row="1" Grid.Column="1" MinWidth="200" HorizontalAlignment="Left" Margin="2, 2, 0, 2" 
			    Validation.ErrorTemplate="{StaticResource validationTemplate}" 
			    Style="{StaticResource textBoxInError}">
                <Binding Path="User.LoginName" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <validators:DataLengthRule ValidatesOnTargetUpdated="True"/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <TextBlock Grid.Row="1" Grid.Column="2" Margin="5, 5, 0, 2" Foreground="{StaticResource ErrorBrush}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Error: {0}">
                        <Binding ElementName="LoginText" Path="(Validation.Errors)[0].ErrorContent"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <Label Grid.Row="2" Grid.Column="0" Content="Password" HorizontalAlignment="Left"/>
            <TextBox x:Name="PasswordText" Grid.Row="2" Grid.Column="1" MinWidth="200" HorizontalAlignment="Left" Margin="2, 2, 0, 2" 
			    Validation.ErrorTemplate="{StaticResource validationTemplate}" 
			    Style="{StaticResource textBoxInError}">
                <Binding Path="User.Password" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <validators:PasswordRule ValidatesOnTargetUpdated="True"/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <TextBlock Grid.Row="2" Grid.Column="2" Margin="5, 5, 0, 2" Foreground="{StaticResource ErrorBrush}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Error: {0}">
                        <Binding ElementName="PasswordText" Path="(Validation.Errors)[0].ErrorContent"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <Label Grid.Row="3" Grid.Column="0" Content="First Name" HorizontalAlignment="Left"/>
            <TextBox x:Name="FirstNameText" Grid.Row="3" Grid.Column="1" MinWidth="200" HorizontalAlignment="Left" Margin="2, 2, 0, 2" 
			    Validation.ErrorTemplate="{StaticResource validationTemplate}" 
			    Style="{StaticResource textBoxInError}">
                <Binding Path="User.FirstName" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <validators:DataLengthRule ValidatesOnTargetUpdated="True"/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <TextBlock Grid.Row="3" Grid.Column="2" Margin="5, 5, 0, 2" Foreground="{StaticResource ErrorBrush}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Error: {0}">
                        <Binding ElementName="FirstNameText" Path="(Validation.Errors)[0].ErrorContent"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <Label Grid.Row="4" Grid.Column="0" Content="Surname" HorizontalAlignment="Left"/>
            <TextBox x:Name="SurnameText" Grid.Row="4" Grid.Column="1" MinWidth="200" HorizontalAlignment="Left" Margin="2, 2, 0, 2" 
			    Validation.ErrorTemplate="{StaticResource validationTemplate}" 
			    Style="{StaticResource textBoxInError}">
                <Binding Path="User.Surname" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <validators:DataLengthRule ValidatesOnTargetUpdated="True"/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <TextBlock Grid.Row="4" Grid.Column="2" Margin="5, 5, 0, 2" Foreground="{StaticResource ErrorBrush}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Error: {0}">
                        <Binding ElementName="SurnameText" Path="(Validation.Errors)[0].ErrorContent"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <Label Grid.Row="5" Grid.Column="0" Content="Birth Date" HorizontalAlignment="Left"/>
            <DatePicker x:Name="BirthDatePicker" Grid.Row="5" Grid.Column="1" MinWidth="250" HorizontalAlignment="Left" Margin="2, 2, 0, 2"
                        DisplayDateStart="{Binding MinimumBirthDate, Mode=OneWay}" DisplayDateEnd="{Binding MaximumBirthDate, Mode=OneWay}">
                <DatePicker.SelectedDate>
                    <Binding Path="User.BirthDate" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:BirthDateRule ValidatesOnTargetUpdated="True"/>
                        </Binding.ValidationRules>
                    </Binding>
                </DatePicker.SelectedDate>
            </DatePicker>
            <TextBlock Grid.Row="5" Grid.Column="2" Margin="5, 5, 0, 2" Foreground="{StaticResource ErrorBrush}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Error: {0}">
                        <Binding ElementName="BirthDatePicker" Path="(Validation.Errors)[0].ErrorContent"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <Label Grid.Row="6" Grid.Column="0" Content="Birth Place" HorizontalAlignment="Left"/>
            <TextBox x:Name="BirthPlaceText" Grid.Row="6" Grid.Column="1" MinWidth="200" HorizontalAlignment="Left" Margin="2, 2, 0, 2" 
			    Validation.ErrorTemplate="{StaticResource validationTemplate}" 
			    Style="{StaticResource textBoxInError}">
                <Binding Path="User.BirthPlace" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <validators:DataLengthRule ValidatesOnTargetUpdated="True"/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <TextBlock Grid.Row="6" Grid.Column="2" Margin="5, 5, 0, 2" Foreground="{StaticResource ErrorBrush}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Error: {0}">
                        <Binding ElementName="BirthPlaceText" Path="(Validation.Errors)[0].ErrorContent"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <Label Grid.Row="7" Grid.Column="0" Content="Address City" HorizontalAlignment="Left"/>
            <TextBox x:Name="AddressCityText" Grid.Row="7" Grid.Column="1" MinWidth="200" HorizontalAlignment="Left" Margin="2, 2, 0, 2" 
			    Validation.ErrorTemplate="{StaticResource validationTemplate}" 
			    Style="{StaticResource textBoxInError}">
                <Binding Path="User.AddressCity" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <validators:DataLengthRule ValidatesOnTargetUpdated="True"/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <TextBlock Grid.Row="7" Grid.Column="2" Margin="5, 5, 0, 2" Foreground="{StaticResource ErrorBrush}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Error: {0}">
                        <Binding ElementName="AddressCityText" Path="(Validation.Errors)[0].ErrorContent"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <Button Grid.Row="9" Grid.Column="0" Content="💾 Save" Command="{Binding SaveCommand, Mode=Default, Converter={converters:CommandAdapterConverter}}">
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="IsEnabled" Value="false" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding (Validation.HasError), ElementName=LoginText}" Value="false" />
                                    <Condition Binding="{Binding (Validation.HasError), ElementName=PasswordText}" Value="false" />
                                    <Condition Binding="{Binding (Validation.HasError), ElementName=FirstNameText}" Value="false" />
                                    <Condition Binding="{Binding (Validation.HasError), ElementName=SurnameText}" Value="false" />
                                    <Condition Binding="{Binding (Validation.HasError), ElementName=BirthDatePicker}" Value="false" />
                                    <Condition Binding="{Binding (Validation.HasError), ElementName=BirthPlaceText}" Value="false" />
                                    <Condition Binding="{Binding (Validation.HasError), ElementName=AddressCityText}" Value="false" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="true" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Row="9" Grid.Column="1" Content="❌ Cancel" HorizontalAlignment="Left"
                    Command="{Binding CancelCommand, Mode=Default, Converter={converters:CommandAdapterConverter}}"/>
        </Grid>

        <Label Content=" User Manager by Robert Oze - www.4dillusions.com" FontSize="13" FontWeight="Bold" Height="40" Width="746" HorizontalAlignment="Center"
               VerticalAlignment="Center" Foreground="{StaticResource HeaderTextBrush}" Background="{StaticResource FooterBackgroundBrush}"/>
    </StackPanel>
</UserControl>
