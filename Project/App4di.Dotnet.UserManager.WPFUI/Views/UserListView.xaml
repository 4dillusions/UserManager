<UserControl
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:App4di.Dotnet.UserManager.WPFUI.Converters"
        x:Class="App4di.Dotnet.UserManager.WPFUI.UserListView" Height="496" Width="910"
        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <StackPanel>
        <Label Content="  Please Select a User" FontSize="20" FontWeight="Bold" Width="910" VerticalAlignment="Center" Foreground="{StaticResource HeaderTextBrush}"
                   Background="{StaticResource HeaderBackgroundBrush}"/>
        <Label Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="7"/>
        <Image Width="100" Height="100" Margin="0, 10, 0, 0" Source="../Contents/users.png"/>
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500*"/>
                <ColumnDefinition Width="241*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="250" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Grid.ColumnSpan="2">
                <Label Grid.Row="0" Content="Address City"/>
                <ComboBox MinWidth="200" Margin="10, 2, 0, 2" ItemsSource="{Binding AddressCities}" SelectedItem="{Binding SelectedAddressCity, Mode=TwoWay}"/>
                <Label Grid.Row="0" Content="Search"/>
                <TextBox MinWidth="200" Margin="10, 2, 0, 4" Text="{Binding TextInAll, Mode=TwoWay}"/>
                <Button MinWidth="30" MaxWidth="30" Margin="2, 2, 0, 2" Content="X" ToolTip="Clear search"
                        Command="{Binding ClearSearchCommand, Mode=Default, Converter={converters:CommandAdapterConverter}}"/>
                <Button MinWidth="120" Margin="10, 2, 0, 2" Content="🔍 Search" Command="{Binding FindCommand, Mode=Default, Converter={converters:CommandAdapterConverter}}"/>
            </StackPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}" 
                 HeadersVisibility="Column" AutoGenerateColumns="False" IsReadOnly="True" Grid.ColumnSpan="2" SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource InactiveSelectionColor}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource InactiveSelectionTextColor}"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="*" />
                    <DataGridTextColumn Header="Login Name" Binding="{Binding LoginName}" Width="*" />
                    <DataGridTextColumn Header="Password" Binding="{Binding Password}" Width="*" />
                    <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="*" />
                    <DataGridTextColumn Header="Surname" Binding="{Binding Surname}" Width="*" />
                    <DataGridTextColumn Header="Birth Date" Binding="{Binding BirthDate}" Width="*" />
                    <DataGridTextColumn Header="Birth Place" Binding="{Binding BirthPlace}" Width="*" />
                    <DataGridTextColumn Header="Address" Binding="{Binding AddressCity}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
                  
            <Grid Grid.Row="2" Grid.ColumnSpan="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button MinWidth="140" MaxWidth="140" Margin="5,0,0,0" Content="✏️ Edit User" Command="{Binding EditCommand, Mode=Default, Converter={converters:CommandAdapterConverter}}"/>
                </StackPanel>
                <Button MinWidth="180" MaxWidth="180" HorizontalAlignment="Right" Margin="0,0,5,0" Content="📤 Export to JSON"
                        Command="{Binding ExportCommand, Mode=Default, Converter={converters:CommandAdapterConverter}}"/>
            </Grid>
        </Grid>

        <Label Content=" User Manager by Robert Oze - www.4dillusions.com" FontSize="13" FontWeight="Bold" Height="40" Width="910" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Foreground="{StaticResource HeaderTextBrush}" Background="{StaticResource FooterBackgroundBrush}"/>
    </StackPanel>
</UserControl>
